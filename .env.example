# Loopback bind address and port (non-loopback hosts are rejected)
HOST=127.0.0.1
PORT=8080

# Metaphor direct inference and auth endpoints
METAPHOR_UPSTREAM=https://llms.withmetaphor.com
METAPHOR_API_URL=https://withmetaphor.com/api

# Optional explicit credentials (on Windows, omit to read your Metaphor desktop sign-in from Credential Manager)
METAPHOR_ACCESS_TOKEN=
METAPHOR_REFRESH_TOKEN=

# Optional bearer / x-api-key secret required from local clients
LOCAL_API_KEY=
